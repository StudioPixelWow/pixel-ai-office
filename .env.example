# Public (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key>
NEXT_PUBLIC_SITE_URL=https://manage.s-pixel.co.il
# Server-only secrets (set in Vercel as Sensitive; never commit)
WORKER_SECRET=          # optional; defaults to CRON_SECRET. Owner registers its hash from the setup checklist
CRON_SECRET=            # >=32 random chars, set by Tal in Vercel (Sensitive). Vercel cron sends it as Bearer
ANTHROPIC_API_KEY=      # Claude (Opus 5.5 for complex work)
OPENAI_API_KEY=         # OpenAI Images API — a separate, explicit billing path from ChatGPT
OPENAI_IMAGE_MODEL=gpt-image-1
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=    # webhook signature (X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=
